{
  "name": "bullshit-poker-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/**/*.test.ts",
    "test:engine": "node --test tests/shared/*.test.ts",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build",
    "dev": "npm run build && wrangler dev --local",
    "deploy": "npm run check && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1",
    "typescript": "6.0.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "lucide-react": "1.11.0",
    "@noble/hashes": "2.3.0",
    "qrcode": "1.5.4",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "25.6.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.4",
    "eslint": "10.2.1",
    "prettier": "3.8.3",
    "typescript-eslint": "8.67.0",
    "wrangler": "4.124.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
